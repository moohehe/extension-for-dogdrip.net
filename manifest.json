{
    "manifest_version": 3,
    "name": "extension for dogdrip.net",
    "version": "2.0.0",
    "description": "Dogdrip.net 확장프로그램",
    "permissions": ["activeTab", "storage", "tabs"],
    "host_permissions": ["https://www.dogdrip.net/*"],
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": {
            "16": "images/get_started16.png",
            "32": "images/get_started32.png",
            "48": "images/get_started48.png",
            "128": "images/get_started128.png"
        },
        "default_popup": "popup.html",
        "default_title": "Dogdrip.net 확장프로그램"
    },
    "icons": {
        "16": "images/get_started16.png",
        "32": "images/get_started32.png",
        "48": "images/get_started48.png",
        "128": "images/get_started128.png"
    },
    "content_scripts": [
        {
            "matches": ["https://www.dogdrip.net/*"],
            "css": ["dogdripextension.css"],
            "js": ["dogdrip.js"],
            "run_at": "document_idle"
        }
    ],
    "commands": {
        "prev": {
            "suggested_key": { "default": "Ctrl+Left" },
            "description": "이전 게시글로 이동"
        },
        "next": {
            "suggested_key": { "default": "Ctrl+Right" },
            "description": "다음 게시글로 이동"
        },
        "list": {
            "suggested_key": { "default": "Ctrl+Down" },
            "description": "목록으로 이동 + 단축키 부여"
        }
    }
}
